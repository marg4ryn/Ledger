{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "es2020",
    "module": "esnext",

    "lib": ["es2020", "DOM"],
    "types": ["vitest/globals"],

    "strict": true,
    "allowJs": true,
    "checkJs": false,

    "sourceMap": true,
    "skipLibCheck": true,

    "paths": {
      "@framework/*": ["./src/framework/*"],
      "@app/*": ["./src/app/*"],
      "@components/*": ["./src/app/components/*"]
    }
  },
  "include": ["src"]
}
